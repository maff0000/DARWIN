# DARWIN Foundation — external configuration reference.
# Copy to .env for local/disposable use only. Never commit a real .env.
# Production-like secrets are supplied as files (see *_FILE variables) or
# through the platform's own secret mechanism — never inline here.

DARWIN_ENV=dev

# --- DARWIN_sql (PostgreSQL) ---
DARWIN_PG_HOST=darwin_sql
DARWIN_PG_PORT=5432
DARWIN_PG_DB=darwin
DARWIN_PG_USER=darwin_app
# Either set DARWIN_PG_PASSWORD directly (disposable/dev only) or point
# DARWIN_PG_PASSWORD_FILE at a mounted secret file (preferred for persistent deployment).
DARWIN_PG_PASSWORD=darwin_app_dev_password
DARWIN_PG_PASSWORD_FILE=

# --- HERMES historical read-only access ---
DARWIN_HERMES_HOST=127.0.0.1
DARWIN_HERMES_PORT=3307
DARWIN_HERMES_DB=tradingSignals
DARWIN_HERMES_USER=darwin_ro
DARWIN_HERMES_PASSWORD=
DARWIN_HERMES_PASSWORD_FILE=/run/secrets/darwin_ro_credential

# --- PID-004C MENDEL Workshop Assistant provider secret ---
# Point this at a mounted file holding the Claude Code provider API key to
# make darwin.workshop.api.register_mendel_routes wire the real
# ClaudeCodeMendelAdapter (darwin.workshop.claude_code_mendel_adapter) in
# place of the deterministic test adapter. Leave empty (the default) to
# keep the deterministic test adapter -- an honest, additive, non-fatal
# default; darwin_core never fails to start over this. Only the *_FILE
# convention is supported here -- never set an inline
# DARWIN_MENDEL_PROVIDER_API_KEY= or ANTHROPIC_API_KEY= anywhere.
DARWIN_MENDEL_PROVIDER_API_KEY_FILE=

# --- Build identity (normally injected at build/deploy time, not hand-edited) ---
DARWIN_BUILD_VERSION=0.1.0
DARWIN_BUILD_COMMIT=unknown
DARWIN_BUILD_TIME=unknown

# --- Logging ---
DARWIN_LOG_LEVEL=INFO
